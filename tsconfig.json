{
  "exclude": ["node_modules", "out", "dist"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "Node16",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "typeRoots": ["node_modules/@types", "./types/*.d.ts"],
    "types": ["node"],
    "paths": {
      "vite": ["./node_modules/vite"],
      "@/*": ["./src/*"]
    }
  }
}
